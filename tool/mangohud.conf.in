# game-research: frame-time logging for the games it studies. Owned by the
# app (rendered from tool/mangohud.conf.in by install.sh and the wrapper);
# kuhy's own MangoHud.conf is never touched. Invisible HUD (alpha 0), one CSV
# per game run in the spool; every frame is logged (log_interval=0) so 1%
# lows are real. Not no_display: MangoHud 0.8.4 stops its logger with it.
alpha=0
background_alpha=0
autostart_log=1
log_interval=0
output_folder=@SPOOL@
